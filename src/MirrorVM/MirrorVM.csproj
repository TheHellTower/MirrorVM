<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>MirrorVM</AssemblyName>
    <RootNamespace>MirrorVM.Protector</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
    <ProjectReference Include="..\MirrorVM.Runtime\MirrorVM.Runtime.csproj" />
  </ItemGroup>

  <Target Name="CopyNet20RuntimeForProtectedAssemblies" AfterTargets="Build">
    <MSBuild Projects="..\MirrorVM.Runtime\MirrorVM.Runtime.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net20" />
    <MakeDir Directories="$(TargetDir)runtime\net20" />
    <Copy SourceFiles="..\..\Release\$(Configuration)\net20\MirrorVM.Runtime.dll" DestinationFolder="$(TargetDir)runtime\net20" />
  </Target>
</Project>
